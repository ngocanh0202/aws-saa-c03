# Sao chép file này thành .env.local rồi điền giá trị từ Firebase console (xem docs/firebase-setup.md).
# Bỏ trống thì web vẫn chạy bình thường, chỉ không có đăng nhập và đồng bộ.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Bắt buộc để dùng Hỏi Gemini (Firebase yêu cầu App Check cho AI Logic); thiếu thì ẩn nút Gemini. Khóa reCAPTCHA Enterprise, xem docs/firebase-setup.md.
VITE_RECAPTCHA_SITE_KEY=
# Tùy chọn: tên model Gemini. Bỏ trống thì dùng gemini-3.5-flash.
VITE_GEMINI_MODEL=
# Tùy chọn: chế độ AI thử nghiệm qua LM Studio + Cloudflare Tunnel (xem docs/local-ai.md).
VITE_LOCAL_AI=
VITE_LOCAL_AI_MODEL=
