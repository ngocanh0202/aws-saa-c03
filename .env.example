# Sao chép file này thành .env.local rồi điền giá trị từ Firebase console (xem docs/firebase-setup.md).
# Bỏ trống thì web vẫn chạy bình thường, chỉ không có đăng nhập và đồng bộ.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
