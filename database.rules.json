{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "attempts": {
          "$attemptId": {
            ".validate": "newData.hasChildren(['json', 'updatedAt']) && newData.child('json').isString() && newData.child('json').val().length < 200000 && newData.child('updatedAt').isNumber()"
          }
        },
        "aiChats": {
          "$attemptId": {
            "$qid": {
              ".validate": "newData.hasChildren(['json', 'updatedAt']) && newData.child('json').isString() && newData.child('json').val().length < 200000 && newData.child('updatedAt').isNumber()"
            }
          }
        },
        "localChats": {
          "$attemptId": {
            "$qid": {
              ".validate": "newData.hasChildren(['json', 'updatedAt']) && newData.child('json').isString() && newData.child('json').val().length < 200000 && newData.child('updatedAt').isNumber()"
            }
          }
        },
        "aiSettings": {
          ".validate": "newData.hasChildren(['temperature', 'top_p', 'top_k', 'min_p', 'presence_penalty', 'stream', 'webSearch'])",
          "temperature": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2" },
          "top_p": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 1" },
          "top_k": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0" },
          "min_p": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1" },
          "presence_penalty": { ".validate": "newData.isNumber() && newData.val() >= -2 && newData.val() <= 2" },
          "max_tokens": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 32768 && newData.val() % 1 === 0" },
          "stream": { ".validate": "newData.isBoolean()" },
          "webSearch": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },
    "support": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true))",
        "messages": {
          "$id": {
            ".write": "auth != null && !data.exists() && ((newData.child('from').val() === 'user' && auth.uid === $uid) || (newData.child('from').val() === 'admin' && auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true))",
            ".validate": "newData.hasChildren(['from', 'text', 'at']) && ((auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true) || (newData.child('at').val() === now && newData.parent().parent().parent().parent().child('supportIndex').child($uid).child('updatedAt').val() === now))",
            "from": { ".validate": "newData.val() === 'user' || newData.val() === 'admin'" },
            "text": { ".validate": "newData.isString() && newData.val().length <= 4000 && (newData.val().length > 0 || newData.parent().hasChild('error'))" },
            "at": { ".validate": "newData.isNumber() && newData.val() <= now + 60000" },
            "error": {
              ".validate": "newData.hasChildren(['message', 'page', 'at'])",
              "message": { ".validate": "newData.isString() && newData.val().length <= 1000" },
              "code": { ".validate": "newData.isString() && newData.val().length <= 100" },
              "page": { ".validate": "newData.isString() && newData.val().length <= 500" },
              "at": { ".validate": "newData.isNumber()" },
              "$other": { ".validate": false }
            },
            "$other": { ".validate": false }
          }
        }
      }
    },
    "supportIndex": {
      ".read": "auth != null && auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true",
      ".indexOn": ["updatedAt"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || (auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true))",
        ".write": "auth != null && ((auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true) || (auth.uid === $uid && newData.child('updatedAt').exists()))",
        "name": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "email": { ".validate": "newData.isString() && newData.val().length <= 200 && ((auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true) || newData.val() === auth.token.email)" },
        "updatedAt": { ".validate": "newData.isNumber() && newData.val() <= now + 60000 && ((auth.token.email === 'buihngocanh2@gmail.com' && auth.token.email_verified === true) || (newData.val() === now && (!data.exists() || newData.val() >= data.val() + 3000)))" },
        "last": { ".validate": "newData.isString() && newData.val().length <= 81" },
        "lastFrom": { ".validate": "newData.val() === 'user' || newData.val() === 'admin'" },
        "unreadByAdmin": { ".validate": "newData.isBoolean()" },
        "unreadByUser": { ".validate": "newData.isBoolean()" },
        "$other": { ".validate": false }
      }
    }
  }
}
